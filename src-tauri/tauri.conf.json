{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juridix",
  "version": "1.1.4",
  "identifier": "fr.juridix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3910",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "Juridix",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' http://localhost:51873; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Pierre Couget",
    "copyright": "© 2026 Pierre Couget",
    "category": "Productivity",
    "shortDescription": "Assistant IA juridique",
    "longDescription": "Juridix est un assistant IA desktop utilisant les API Albert et Anthropic, conçu pour les professionnels du droit — recherche Légifrance et JUDILIBRE, RAG documentaire et outils MCP.",
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "French"
        ]
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
